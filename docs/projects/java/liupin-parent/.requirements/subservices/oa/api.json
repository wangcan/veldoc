  "components": {
    "schemas": {
      "ApiResponse": {
        "type": "object",
        "description": "统一响应对象",
        "properties": {
          "code": {
            "type": "integer",
            "description": "状态码"
          },
          "message": {
            "type": "string",
            "description": "响应消息"
          },
          "data": {
            "type": "object",
            "description": "响应数据"
          }
        }
      },
      "PersionDutyResultParam": {
        "type": "object",
        "description": "个人职责结果参数",
        "properties": {
          "persionDutyId": {
            "type": "integer",
            "description": "个人职责ID"
          },
          "dutyTypeList": {
            "type": "array",
            "description": "职责类型列表",
            "items": {
              "$ref": "#/components/schemas/BizPersionDutyType"
            }
          },
          "habitList": {
            "type": "array",
            "description": "工作习惯列表",
            "items": {
              "$ref": "#/components/schemas/BizPersionWorkHabit"
            }
          }
        },
        "required": ["persionDutyId"]
      },
      "BizPersionDutyType": {
        "type": "object",
        "description": "职责类型",
        "properties": {
          "id": {
            "type": "integer",
            "description": "ID"
          },
          "typeName": {
            "type": "string",
            "description": "类型名称"
          }
        }
      },
      "BizPersionWorkHabit": {
        "type": "object",
        "description": "工作习惯",
        "properties": {
          "id": {
            "type": "integer",
            "description": "ID"
          },
          "habitName": {
            "type": "string",
            "description": "习惯名称"
          }
        }
      },
      "BizWelfareUpdateParam": {
        "type": "object",
        "description": "薪酬福利更新参数",
        "properties": {
          "fdId": {
            "type": "string",
            "description": "员工ID"
          },
          "fdIdCard": {
            "type": "string",
            "description": "身份证号"
          },
          "fdPayrollAccount": {
            "type": "string",
            "description": "银行账号"
          },
          "fdSurplusAccount": {
            "type": "string",
            "description": "收款方联行号"
          },
          "fdPayrollName": {
            "type": "string",
            "description": "开户银行"
          },
          "fdPayrollBank": {
            "type": "string",
            "description": "开户行"
          },
          "fdSocialSecurityNumber": {
            "type": "string",
            "description": "支付宝账号"
          }
        },
        "required": ["fdId"]
      },
      "BizSalaryParam": {
        "type": "object",
        "description": "薪资参数",
        "properties": {
          "fdMobileNo": {
            "type": "string",
            "description": "手机号（11位）"
          },
          "probationSalary": {
            "type": "string",
            "description": "试用薪资"
          },
          "regularSalary": {
            "type": "string",
            "description": "转正薪资"
          }
        },
        "required": ["fdMobileNo", "probationSalary", "regularSalary"]
      }
    }
  }
