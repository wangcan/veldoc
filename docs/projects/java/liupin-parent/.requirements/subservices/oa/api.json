    "/api/v1/sysOrgElement/auth": {
      "post": {
        "tags": ["组织架构管理"],
        "summary": "授权认证",
        "description": "使用secret和sign进行身份验证，验证成功后返回授权信息",
        "operationId": "sysOrgElementAuth",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "secret": {
                    "type": "string",
                    "description": "密钥"
                  },
                  "sign": {
                    "type": "string",
                    "description": "签名"
                  }
                },
                "required": ["secret", "sign"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          },
          "401": {
            "description": "认证失败"
          }
        }
      }
    },
