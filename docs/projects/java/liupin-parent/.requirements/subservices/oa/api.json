    "/api/v1/staffEntry/pendingEmploymentInsert": {
      "get": {
        "tags": ["员工入职管理"],
        "summary": "待入职员工信息提交",
        "description": "员工待入职信息提交，先将待入职的数据保存至数据库，然后定时匹配员工表里的手机号，将数据修改",
        "operationId": "pendingEmploymentInsert",
        "parameters": [
          {
            "name": "userFdId",
            "in": "query",
            "description": "用户ID",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fdMobileNo",
            "in": "query",
            "description": "手机号",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "rank",
            "in": "query",
            "description": "职级",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "contractType",
            "in": "query",
            "description": "合同类型：1-劳动合同 2-劳务合同 3-实习合同 4-兼职合同 5-其他合同",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "superiorLeader",
            "in": "query",
            "description": "上级领导",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "supervisor",
            "in": "query",
            "description": "导师",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "employeeStatus",
            "in": "query",
            "description": "员工状态：1-全职 2-兼职 3-实习 4-临时工 5-退休返聘 6-劳务 7-外派",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "isContinuousService",
            "in": "query",
            "description": "是否为连续工龄：1-是 2-否",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "clothingSize",
            "in": "query",
            "description": "衣服尺寸：1-S 2-M 3-L 4-XL 5-XXL 6-XXXL",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
