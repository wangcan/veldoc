<table width='100%' class='codestyle'><pre><code>{
    "message": "The name field must be a string.",
    "errors": {
        "name": [
            "The name field must be a string."
        ]
    },
    "code": 1
}
</code></pre></table></div><h2>3.3、Change current user password</h2><div style="margin-left:20px;"><h5>简要描述</h5>
<ul>
<li>Changes the authenticated user's password. Requires the current password to match. All existing tokens remain valid unless explicitly invalidated.</li>
</ul>
<h5>请求URL</h5>
<ul>
<li><code>{{host}}/api/v1/user-center/users/change-password</code> </li>
</ul>
<h5>请求方式</h5>
<ul>
<li>post</li>
</ul>
<h5>请求参数示例</h5>
<table width='100%' class='codestyle'><pre><code>{
    "current_password": "string",
    "password": "string",
    "password_confirmation": "string"
}
</code></pre></table>
<h5>json字段说明</h5>
<table>
<thead><tr style='background-color: rgb(0, 136, 204); color: rgb(255, 255, 255);'>
<th style="text-align: left;">字段名</th>
<th style="text-align: left;">必选</th>
<th>类型</th>
<th>说明</th>
</tr>
</thead>
<tbody>
<tr>
<td style="text-align: left;">current_password</td>
<td style="text-align: left;">是</td>
<td>string</td>
<td>The user's current password.</td>
</tr>
<tr>
<td style="text-align: left;">password</td>
<td style="text-align: left;">是</td>
<td>string</td>
<td>New password.</td>
</tr>
<tr>
<td style="text-align: left;">password_confirmation</td>
<td style="text-align: left;">否</td>
<td>string</td>
<td>Must match <code>password</code>.</td>
</tr>
</tbody>
</table>
<h5>成功返回示例</h5>
