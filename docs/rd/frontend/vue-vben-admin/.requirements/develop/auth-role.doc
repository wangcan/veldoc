<th style="text-align: left;">示例值</th>
<th>必选</th>
<th>类型</th>
<th>说明</th>
</tr>
</thead>
<tbody>
<tr>
<td style="text-align: left;">per_page</td>
<td style="text-align: left;"></td>
<td>否</td>
<td>string</td>
<td>Number of items per page. The default differs by endpoint: the users index defaults to 15, the roles index defaults to 10.</td>
</tr>
<tr>
<td style="text-align: left;">status</td>
<td style="text-align: left;"></td>
<td>否</td>
<td>string</td>
<td>Filter by user status.</td>
</tr>
<tr>
<td style="text-align: left;">search</td>
<td style="text-align: left;"></td>
<td>否</td>
<td>string</td>
<td>Free-text search across name, email, and phone (LIKE match).</td>
</tr>
<tr>
<td style="text-align: left;">role</td>
<td style="text-align: left;"></td>
<td>否</td>
<td>string</td>
<td>Filter by role code/name.</td>
</tr>
</tbody>
</table>
