{
  "openapi": "3.0.0",
  "info": {
    "title": "BaseTool API",
    "description": "基础工具模块API文档 - 提供验证码、短信发送和二维码功能",
    "version": "1.0.0",
    "contact": {
      "name": "API Support"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8000/api/v1/base-tool",
      "description": "开发环境"
    }
  ],
  "tags": [
    {
      "name": "captcha",
      "description": "验证码相关接口"
    },
    {
      "name": "sms",
      "description": "短信发送相关接口"
    },
    {
      "name": "qrcode",
      "description": "二维码相关接口"
    }
  ],
  "paths": {
    "/captcha": {
      "get": {
        "tags": ["captcha"],
        "summary": "生成验证码",
        "description": "生成一个新的图像验证码，返回验证码key和图像URL",
        "operationId": "generateCaptcha",
        "parameters": [
          {
            "name": "length",
            "in": "query",
            "description": "验证码长度，默认5位",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 5,
              "minimum": 4,
              "maximum": 8
            }
          },
          {
            "name": "width",
            "in": "query",
            "description": "图像宽度，默认120像素",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 120
            }
          },
          {
            "name": "height",
            "in": "query",
            "description": "图像高度，默认36像素",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 36
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功生成验证码",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "key": {
                          "type": "string",
                          "description": "验证码唯一标识",
                          "example": "captcha_abc123def456"
                        },
                        "captcha": {
                          "type": "string",
                          "description": "验证码图像URL或base64",
                          "example": "data:image/png;base64,..."
                        },
                        "expire": {
                          "type": "integer",
                          "description": "过期时间（秒）",
                          "example": 300
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/captcha/verify": {
      "post": {
        "tags": ["captcha"],
        "summary": "验证验证码",
        "description": "验证用户输入的验证码是否正确",
        "operationId": "verifyCaptcha",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["key", "value"],
                "properties": {
                  "key": {
                    "type": "string",
                    "description": "验证码唯一标识",
                    "example": "captcha_abc123def456"
                  },
                  "value": {
                    "type": "string",
                    "description": "用户输入的验证码值",
                    "example": "A2b3C"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "验证成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Captcha verified successfully"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "验证失败",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": false
                    },
                    "message": {
                      "type": "string",
                      "example": "Invalid or expired captcha"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/sms/send": {
      "post": {
        "tags": ["sms"],
        "summary": "发送短信",
        "description": "发送短信到指定手机号（受频率限制：每分钟1次，每天5次）",
        "operationId": "sendSms",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["phone", "content"],
                "properties": {
                  "phone": {
                    "type": "string",
                    "pattern": "^1[3-9]\\d{9}$",
                    "description": "中国大陆手机号",
                    "example": "13800138000"
                  },
                  "content": {
                    "type": "string",
                    "maxLength": 500,
                    "description": "短信内容",
                    "example": "您的验证码是123456"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "短信发送成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "SMS sent successfully"
                    },
                    "message_id": {
                      "type": "string",
                      "description": "短信网关返回的消息ID",
                      "example": "msg_123456789"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "短信发送失败",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": false
                    },
                    "message": {
                      "type": "string",
                      "example": "Failed to send SMS"
                    },
                    "error": {
                      "type": "string",
                      "example": "Error details"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "频率限制",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": false
                    },
                    "message": {
                      "type": "string",
                      "example": "Please wait 60 seconds before sending another SMS"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/sms/send-code": {
      "post": {
        "tags": ["sms"],
        "summary": "发送验证码",
        "description": "发送短信验证码到指定手机号（受频率限制：每分钟1次，每天5次）",
        "operationId": "sendSmsCode",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["phone"],
                "properties": {
                  "phone": {
                    "type": "string",
                    "pattern": "^1[3-9]\\d{9}$",
                    "description": "中国大陆手机号",
                    "example": "13800138000"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "验证码发送成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "SMS sent successfully"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "频率限制",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": false
                    },
                    "message": {
                      "type": "string",
                      "example": "Daily SMS limit exceeded"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/sms/verify-code": {
      "post": {
        "tags": ["sms"],
        "summary": "验证短信验证码",
        "description": "验证用户输入的短信验证码是否正确",
        "operationId": "verifySmsCode",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["phone", "code"],
                "properties": {
                  "phone": {
                    "type": "string",
                    "pattern": "^1[3-9]\\d{9}$",
                    "description": "中国大陆手机号",
                    "example": "13800138000"
                  },
                  "code": {
                    "type": "string",
                    "minLength": 6,
                    "maxLength": 6,
                    "description": "6位验证码",
                    "example": "123456"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "验证成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Code verified successfully"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "验证失败",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": false
                    },
                    "message": {
                      "type": "string",
                      "example": "Invalid or expired verification code"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/qrcode/generate": {
      "post": {
        "tags": ["qrcode"],
        "summary": "生成二维码",
        "description": "根据内容生成二维码图像",
        "operationId": "generateQrCode",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["content"],
                "properties": {
                  "content": {
                    "type": "string",
                    "maxLength": 2048,
                    "description": "二维码内容",
                    "example": "https://example.com"
                  },
                  "size": {
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 1000,
                    "default": 300,
                    "description": "二维码尺寸（像素）",
                    "example": 300
                  },
                  "format": {
                    "type": "string",
                    "enum": ["png", "svg"],
                    "default": "png",
                    "description": "输出格式",
                    "example": "png"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "二维码生成成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "qrcode": {
                          "type": "string",
                          "description": "二维码图像（base64或SVG）",
                          "example": "data:image/png;base64,..."
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/qrcode/generate-with-logo": {
      "post": {
        "tags": ["qrcode"],
        "summary": "生成带Logo的二维码",
        "description": "根据内容生成带有Logo的二维码图像",
        "operationId": "generateQrCodeWithLogo",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["content", "logo"],
                "properties": {
                  "content": {
                    "type": "string",
                    "maxLength": 2048,
                    "description": "二维码内容",
                    "example": "https://example.com"
                  },
                  "logo": {
                    "type": "string",
                    "format": "binary",
                    "description": "Logo图像文件（最大1MB）"
                  },
                  "size": {
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 1000,
                    "default": 300,
                    "description": "二维码尺寸（像素）",
                    "example": 300
                  },
                  "logo_size": {
                    "type": "integer",
                    "minimum": 10,
                    "maximum": 100,
                    "default": 50,
                    "description": "Logo占二维码的百分比",
                    "example": 50
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "带Logo的二维码生成成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "qrcode": {
                          "type": "string",
                          "description": "二维码图像（base64）",
                          "example": "data:image/png;base64,..."
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/qrcode/decode": {
      "post": {
        "tags": ["qrcode"],
        "summary": "解码二维码",
        "description": "从图像中解码二维码内容",
        "operationId": "decodeQrCode",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["image"],
                "properties": {
                  "image": {
                    "type": "string",
                    "format": "binary",
                    "description": "二维码图像文件（最大2MB）"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "二维码解码成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "content": {
                          "type": "string",
                          "description": "二维码内容",
                          "example": "https://example.com"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "解码失败",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": false
                    },
                    "message": {
                      "type": "string",
                      "example": "Unable to decode QR code from image"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "message": {
            "type": "string",
            "example": "Error message"
          }
        }
      },
      "ValidationError": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Validation failed"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
